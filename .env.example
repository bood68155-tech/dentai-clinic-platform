# Postgres connection string used by the app, drizzle-kit and the seed script.
#
# Works with any Postgres: Neon, Vercel Postgres, Supabase, RDS or a local
# instance. For Neon copy the *pooled* connection string from
# console.neon.tech → Project → Connection details, then keep ?sslmode=require.
#
#   psql postgresql://user:password@host:5432/db?sslmode=require
#
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Conversational booking assistant (POST /api/assistant).
#
# Uses any OpenAI-compatible /chat/completions endpoint that supports function
# calling. Leave ASSISTANT_API_KEY empty to ship the site without the widget —
# it then shows a "call the clinic" fallback instead of failing.
#
# Defaults target Z.ai; ASSISTANT_BASE_URL and ASSISTANT_MODEL let the clinic
# switch provider (or model) without a code change.
ASSISTANT_API_KEY=""
ASSISTANT_BASE_URL="https://api.z.ai/api/paas/v4"
ASSISTANT_MODEL="glm-4.5-flash"
