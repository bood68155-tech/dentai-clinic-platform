# Postgres connection string used by the app, drizzle-kit and the seed script.
#
# Works with any Postgres: Neon, Vercel Postgres, Supabase, RDS or a local
# instance. For Neon copy the *pooled* connection string from
# console.neon.tech → Project → Connection details, then keep ?sslmode=require.
#
#   psql postgresql://user:password@host:5432/db?sslmode=require
#
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
